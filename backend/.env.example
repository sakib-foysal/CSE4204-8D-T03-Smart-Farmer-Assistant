# Copy this file to backend/.env. Never commit the real key.
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=False
# Neon supplies a PostgreSQL connection URL.  Use its pooled URL in Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1,cse4204-8d-t03-smart-farmer-assistant.onrender.com
# Add a custom Vercel domain here if one is used.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=^https://([a-z0-9-]+\.)?vercel\.app$

# REQUIRED FOR THE Gemini CHATBOT - PASTE YOUR KEY HERE
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=Gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=25
